<root main_tree_to_execute="HpTestTree">
    <BehaviorTree ID="HpTestTree">
        <Sequence>
            <SubSefdefined sefdefined_data="{the_hp_data}" />
            
            <HpDecisionPatrol 
                hp_input="{the_hp_data}"
                high_hp_x="4.10" high_hp_y="-1.14"
                low_hp_x="0.0" low_hp_y="0.0"
                target_pose="{current_goal}" 
                hp_threshold="200"
            />
            
            <SendGoal goal_pose="{current_goal}" />
        </Sequence>
    </BehaviorTree>
</root>